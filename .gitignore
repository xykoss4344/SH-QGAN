**/checkpoint_*.pt
**/*.pt
**/runs/
**/results_crystal_*/
**/results_eval*/
**/results_analysis/
**/experiments/

# Logs
*.log
**/stdout*.log
**/stderr.log

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Data caches (regenerate with datasets/*.py)
**/relaxed_structures.pkl

# Benchmark CIF exports (regenerate with benchmark.py)
bench_out/

