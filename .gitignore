# Third-party binaries — 1.1 GB of Quantum Espresso + Intel MKL DLLs were
# tracked here. Install them with dft/install_qe.py instead of versioning them.
**/qe_binaries/

# Old unrelated clone, kept locally only
_archive/

# Training artefacts: checkpoints are 2.7 MB each and there are thousands.
